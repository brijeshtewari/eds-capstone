{
  "metadata": {
    "projectType": "da"
  },
  "templates": [
    {
      "name": "home",
      "urls": [
        "https://wknd.site/us/en.html"
      ],
      "representativeUrl": "https://wknd.site/us/en.html",
      "description": "WKND US homepage: hero carousel, featured-article promo, recent-articles card grid, next-adventures banner, and destinations card grid.",
      "urlPattern": "/us/*",
      "blocks": [
        {
          "name": "carousel-hero",
          "instances": [
            ".carousel.cmp-carousel--hero",
            ".carousel.panelcontainer.cmp-carousel--hero"
          ]
        },
        {
          "name": "columns-featured",
          "instances": [
            ".teaser.cmp-teaser--featured"
          ]
        },
        {
          "name": "hero-banner",
          "instances": [
            ".teaser.cmp-teaser--hero.cmp-teaser--imagebottom"
          ]
        },
        {
          "name": "cards-article",
          "instances": [
            ".image-list.list"
          ]
        }
      ],
      "sections": [
        {
          "id": "section-1-hero-carousel",
          "name": "hero-carousel",
          "selector": [
            ".carousel.cmp-carousel--hero",
            ".carousel.panelcontainer.cmp-carousel--hero"
          ],
          "style": null,
          "blocks": [
            "carousel-hero"
          ],
          "defaultContent": []
        },
        {
          "id": "section-2-featured-article",
          "name": "featured-article",
          "selector": [
            ".teaser.cmp-teaser--featured"
          ],
          "style": "highlight",
          "blocks": [
            "columns-featured"
          ],
          "defaultContent": []
        },
        {
          "id": "section-3-recent-articles",
          "name": "recent-articles",
          "selector": [
            ".cmp-layout-container--fixed:nth-of-type(1) .image-list.list",
            ".image-list.list"
          ],
          "style": null,
          "blocks": [
            "cards-article"
          ],
          "defaultContent": [
            ".cmp-layout-container--fixed:nth-of-type(1) .cmp-title",
            ".cmp-layout-container--fixed:nth-of-type(1) .button.cmp-button--primary"
          ]
        },
        {
          "id": "section-4-next-adventures-hero",
          "name": "next-adventures-hero",
          "selector": [
            ".teaser.cmp-teaser--hero.cmp-teaser--imagebottom"
          ],
          "style": null,
          "blocks": [
            "hero-banner"
          ],
          "defaultContent": []
        },
        {
          "id": "section-5-where-to-go-cards",
          "name": "where-to-go-cards",
          "selector": [
            ".cmp-layout-container--fixed:nth-of-type(2) .image-list.list",
            ".image-list.list"
          ],
          "style": null,
          "blocks": [
            "cards-article"
          ],
          "defaultContent": [
            ".cmp-layout-container--fixed:nth-of-type(2) .cmp-title",
            ".cmp-layout-container--fixed:nth-of-type(2) .button.cmp-button--primary"
          ]
        }
      ]
    }
  ]
}
